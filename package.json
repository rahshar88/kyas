{
  "name": "kyascene",
  "version": "0.1.0",
  "private": true,
  "description": "KyaScene — the private community app for students from India studying in Australia. Powered by 1818.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "mobile:start": "pnpm --filter @kyascene/mobile start",
    "mobile:config": "pnpm --filter @kyascene/mobile config:show",
    "mobile:prebuild:check": "pnpm --filter @kyascene/mobile prebuild:check",
    "mobile:export": "pnpm --filter @kyascene/mobile export:check",
    "mobile:doctor": "pnpm --filter @kyascene/mobile doctor",
    "verify:eas": "node scripts/verify-eas-config.mjs",
    "assets:generate": "node scripts/generate-placeholder-assets.mjs",
    "mobile:ios": "pnpm --filter @kyascene/mobile ios",
    "mobile:android": "pnpm --filter @kyascene/mobile android",
    "test:rls": "bash scripts/run-rls-tests.sh",
    "test:functions": "cd supabase/functions && deno task check",
    "supabase:deploy": "bash scripts/supabase-deploy.sh",
    "eas:build:preview": "node scripts/verify-eas-config.mjs --profile preview && node scripts/verify-eas-build-env.mjs --profile preview && cd apps/mobile && npx eas-cli@latest build --profile preview --platform ios",
    "eas:update": "node scripts/verify-eas-config.mjs --profile preview && node scripts/verify-eas-build-env.mjs --profile preview && node scripts/eas-update.mjs --profile preview",
    "eas:build:development": "node scripts/verify-eas-config.mjs --profile development && node scripts/verify-eas-build-env.mjs --profile development && cd apps/mobile && npx eas-cli@latest build --profile development --platform ios",
    "verify:eas:env": "node scripts/verify-eas-build-env.mjs",
    "eas:versions": "cd apps/mobile && npx eas-cli@latest build:list --limit 3 --non-interactive && npx eas-cli@latest update:list --branch preview --limit 3 --non-interactive",
    "admin:dev": "pnpm --filter @kyascene/admin dev",
    "admin:build": "pnpm --filter @kyascene/admin build",
    "verify:consent": "node scripts/verify-consent-version.mjs",
    "dev:code": "bash scripts/dev-signin-code.sh",
    "dev:admin": "bash scripts/dev-make-admin.sh",
    "verify:cors": "node scripts/verify-function-cors.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "globals": "^17.9.0",
    "eslint-import-resolver-typescript": "^4.4.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.2",
      "expo": "57.0.12",
      "@expo/metro-runtime": "57.0.9"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-dom",
        "react-native-web",
        "@expo/metro-runtime",
        "react-server-dom-webpack",
        "react-native-webview",
        "@expo/dom-webview"
      ]
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
