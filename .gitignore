# Dependencies
node_modules/
.pnpm-store/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Continuous Native Generation — `ios/` and `android/` are generated by `expo prebuild`
# from app.config.ts on demand. Committing them guarantees drift from the config.
# See docs/decisions/0002-monorepo-and-tooling.md
apps/mobile/ios/
apps/mobile/android/

# Native build output
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Environment — only .env.example is committed
.env
.env.*
!.env.example

# Secrets that must never reach the repository (§13.1)
*.pem
google-services.json
GoogleService-Info.plist
service-account*.json

# Testing and coverage
coverage/
.maestro/output/

# Build info
*.tsbuildinfo

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
