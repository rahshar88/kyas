{
  "name": "@kyascene/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "KyaScene mobile app — Expo SDK 57 / React Native. iOS first, Android second.",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "config:show": "expo config --type public",
    "prebuild:check": "expo prebuild --platform ios --no-install --clean && expo prebuild --platform android --no-install --clean",
    "export:check": "expo export --platform ios --platform android --output-dir .expo/export-check",
    "doctor": "expo-doctor",
    "eas:build:preview": "cd apps/mobile && npx eas-cli@latest build --profile preview --platform ios",
    "eas:update": "cd apps/mobile && npx eas-cli@latest update --branch preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@kyascene/analytics": "workspace:*",
    "@kyascene/contracts": "workspace:*",
    "@kyascene/domain": "workspace:*",
    "@kyascene/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "^1.2.0"
  }
}
