{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.2"
    },
    "dev-environment": {
      "extends": "base",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "https://yvofvmrsnhddpthzgkep.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_s_SszST7DbCgJG-9j4czVQ_opSSFIhu",
        "EXPO_PUBLIC_SUPPORT_URL": "https://kyascene.app/support",
        "EXPO_PUBLIC_PRIVACY_URL": "https://kyascene.app/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://kyascene.app/terms"
      }
    },
    "development": {
      "extends": "dev-environment",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "dev-environment",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "beta": {
      "extends": "base",
      "distribution": "internal",
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "beta"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "development": {},
    "beta": {},
    "production": {},
    "preview": {}
  }
}
