{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_ENVIRONMENT": "development" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "beta": {
      "extends": "base",
      "distribution": "internal",
      "channel": "beta",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ENVIRONMENT": "beta" },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ENVIRONMENT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "development": {},
    "beta": {},
    "production": {}
  }
}
