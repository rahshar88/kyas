# KyaScene mobile environment (spec §5.3)
#
# Copy to `apps/mobile/.env` and fill in. `.env` is gitignored.
#
# ONLY publishable values belong here. Service-role keys, signing credentials and provider
# secrets must NEVER appear in the mobile bundle — anything with the EXPO_PUBLIC_ prefix is
# readable by anyone who downloads the app. Privileged keys live in EAS secrets, CI secrets
# or Supabase Edge Function secrets. See docs/architecture/environments.md.

# development | beta | production
EXPO_PUBLIC_ENVIRONMENT=development

# Supabase project for THIS environment. Beta and production must be separate projects (§5.2).
# The publishable (anon) key only — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-anon-key

# Optional in development, REQUIRED in beta and production (§20).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=

# Must be live before any external beta build ships (§16.4, §18).
EXPO_PUBLIC_SUPPORT_URL=https://kyascene.app/support
EXPO_PUBLIC_PRIVACY_URL=https://kyascene.app/privacy
EXPO_PUBLIC_TERMS_URL=https://kyascene.app/terms
