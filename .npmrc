# React Native's Gradle autolinking, expo-modules-autolinking and CocoaPods all walk
# node_modules using Node-style resolution and do not understand pnpm's symlinked store.
# A hoisted layout is mandatory for an Expo monorepo — see docs/decisions/0002-monorepo-and-tooling.md
node-linker=hoisted

# Expo's SDK packages declare loose peer ranges (expo-router peers `react-dom: "*"`).
# We pin the real versions via pnpm.overrides in the root package.json instead.
strict-peer-dependencies=false
auto-install-peers=true
